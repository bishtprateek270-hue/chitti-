# ==============================================================================
# Chitti - Configuration (Phase 1: Voice Brain + Phase 2: Long-Term Memory)
# ==============================================================================

# LLM (Ollama) Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=60

# Speech-to-Text (STT) Settings
STT_MODEL=base
STT_DEVICE=auto
STT_LANGUAGE=en

# Text-to-Speech (TTS) Settings
TTS_ENGINE=pyttsx3
TTS_RATE=175
TTS_VOLUME=1.0
TTS_VOICE_ID=

# Microphone & Audio Recording Settings
MICROPHONE_DEVICE_INDEX=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SILENCE_THRESHOLD=0.015
AUDIO_SILENCE_DURATION=1.5
AUDIO_MAX_RECORD_SECONDS=30

# Long-Term Memory (Phase 2) Settings
MEMORY_ENABLED=true
MEMORY_DB_PATH=data/memory/chitti_memory.db
EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.35
MEMORY_IMPORTANCE_THRESHOLD=1

# Logging Settings
LOG_LEVEL=INFO
